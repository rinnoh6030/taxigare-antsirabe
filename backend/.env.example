# Clé de signature des tokens JWT (obligatoire en production)
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire

# URL du frontend utilisée dans les QR codes et pour CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de données SQLite. Sur Render, le système de fichiers est éphémère.
DATABASE_URL=sqlite:///./gare.db

# Durée de validité du token (en minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Délai minimal avant le départ pendant lequel un passager peut annuler (heures)
ANNULATION_DELAI_HEURES=2
